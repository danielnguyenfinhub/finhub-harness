+_FUZZ_NAMES = ["l1", "l2", "l3", "mysh", "d", "e"]
+_FUZZ_TOK = _FUZZ_NAMES + ["lnk", "up", "mysh2", "z", "m3", "q", "..", "..", ".", "sub", "bin"]
